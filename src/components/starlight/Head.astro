---
import Default from '@astrojs/starlight/components/Head.astro';
import JsonLd from '../JsonLd.astro';
import Analytics from '../Analytics.astro';
import { organizationSchema, websiteSchema, breadcrumbSchema } from '../../lib/schema';

const site = Astro.site!;
// starlightRoute is injected by Starlight on every docs page (confirmed in
// node_modules/@astrojs/starlight/utils/routing/middleware.ts and types.ts).
const route = (Astro.locals as any).starlightRoute;
const title: string = route?.entry?.data?.title ?? 'Docs';

const crumbs = [
  { name: 'knomit', url: '/' },
  { name: 'Docs', url: '/docs/' },
  { name: title, url: Astro.url.pathname },
];

// og:image lives here rather than in astro.config's `head` array so it can vary
// by route. A tag injected from config is emitted on every docs page with no way
// to override it, and a second og:image would just be a coin-flip for whichever
// crawler reads first. Starlight sets twitter:card but no twitter:image; every
// major unfurler falls back to og:image, so one tag is enough.
const OG_BY_PATH: Record<string, string> = {
  '/docs/okf/': '/og-okf.png',
};
const ogImage = new URL(OG_BY_PATH[Astro.url.pathname] ?? '/og.png', site);
---
<Default><slot /></Default>
<meta property="og:image" content={ogImage} />
<JsonLd schema={organizationSchema(site)} />
<JsonLd schema={websiteSchema(site)} />
<JsonLd schema={breadcrumbSchema(site, crumbs)} />
<Analytics />
