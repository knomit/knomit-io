---
import '@fontsource-variable/space-grotesk';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/theme.css';
// The two faces that paint above the fold, imported as URLs purely so we can
// preload them. Without this the browser can't discover them until it has
// fetched AND parsed the stylesheet, putting the fonts three hops deep:
// document -> CSS -> woff2. On mobile that chain is what sets LCP.
// Deliberately only these two: latin-ext/Vietnamese subsets and mono 500 are
// below the fold or unused, and preloading them would compete for bandwidth
// with the ones that matter. These resolve to the SAME emitted assets the
// @fontsource CSS references, so this adds no extra download.
import spaceGroteskLatin from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import jetbrainsMonoLatin400 from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import JsonLd from './JsonLd.astro';
import Analytics from './Analytics.astro';
import { organizationSchema, websiteSchema, softwareApplicationSchema } from '../lib/schema';
import { SITE_TWITTER, GSC_VERIFICATION } from '../lib/site';

interface Props {
  title: string;
  description: string;
  /** Page-specific OG image path (absolute or site-relative). */
  image?: string;
  article?: boolean;
  /** Page-specific JSON-LD appended after the site-wide Organization/WebSite. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image = '/og.png', article = false, jsonLd } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const site = Astro.site!;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<link rel="preload" as="font" type="font/woff2" href={spaceGroteskLatin} crossorigin />
<link rel="preload" as="font" type="font/woff2" href={jetbrainsMonoLatin400} crossorigin />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
  rel="alternate"
  type="application/rss+xml"
  title="knomit blog"
  href={new URL('/rss.xml', Astro.site)}
/>
<link rel="canonical" href={canonical} />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="theme-color" content="#141414" />

<meta property="og:type" content={article ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="knomit" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
{SITE_TWITTER && <meta name="twitter:site" content={SITE_TWITTER} />}
{SITE_TWITTER && <meta name="twitter:creator" content={SITE_TWITTER} />}
{GSC_VERIFICATION && <meta name="google-site-verification" content={GSC_VERIFICATION} />}

<!-- Mark JS-capable early so scroll-reveal can hide content without a flash;
     no-JS visitors never get the hidden state. -->
<script is:inline>
  document.documentElement.classList.add('has-js');
</script>
<JsonLd schema={organizationSchema(site)} />
<JsonLd schema={websiteSchema(site)} />
<JsonLd schema={softwareApplicationSchema(site)} />
{/* One <script> per node, never one script holding an array. An array is valid
    JSON-LD, but every consumer then has to unwrap it before it can read a
    node's @type — which is exactly what the structured-data e2e checks do, and
    what a post carrying both BlogPosting and FAQPage silently defeated. The
    docs half of the site already emits one tag per node (starlight/Head.astro);
    this makes the marketing half agree. */}
{jsonLd &&
  (Array.isArray(jsonLd) ? jsonLd : [jsonLd]).map((node) => <JsonLd schema={node} />)}
<Analytics />
