---
/** Google Analytics 4 (gtag.js). Emits the tag ONLY when GA_MEASUREMENT_ID is
 *  set, ONLY in production builds, and ONLY when the page is actually being
 *  served from the canonical host. Shared by the marketing <BaseHead> and the
 *  Starlight docs Head override so analytics covers every page from one source.
 *
 *  The host check is the load-bearing one, and it has to be a RUNTIME check.
 *  `import.meta.env.PROD` cannot distinguish the deployed site from CI, because
 *  the deploy job ships the exact artifact CI tested (ci.yml: "no rebuild, no
 *  drift") — so the same PROD build is the one Playwright drives against
 *  `astro preview`. It was firing real page_view hits at the live property from
 *  a GitHub runner, once per test, each from a fresh browser context and so
 *  each counted by GA4 as a new user with a new session. Between every push,
 *  every PR, and eight scheduled KB rebuilds a day, that read as hundreds of
 *  visitors. Where the page is served from is the only thing that genuinely
 *  differs between the two, and it is only knowable in the browser.
 *
 *  Consequence worth knowing: Cloudflare Pages preview deployments
 *  (*.pages.dev) are excluded too, which is intended — they are staging, not
 *  audience. Only the canonical host and its www alias report. */
import { GA_MEASUREMENT_ID } from '../lib/site';

const enabled = Boolean(GA_MEASUREMENT_ID) && import.meta.env.PROD;
// Astro.site is astro.config.mjs's `site` (SITE_URL, defaulting to
// https://knomit.io), so retargeting the domain needs no change here.
const host = new URL(Astro.site ?? 'https://knomit.io').hostname;
---
{
  enabled && (
    <script is:inline define:vars={{ id: GA_MEASUREMENT_ID, host }}>
      (function () {
        // Anywhere else — localhost under `astro preview`, CI, a Pages preview
        // deployment — this returns before a single request is made, so there
        // is nothing to filter out downstream.
        if (location.hostname !== host && location.hostname !== 'www.' + host) return;

        // gtag.js is 167 KB — 63% of the homepage's transfer weight. It is NOT
        // fetched here. Everything below (dataLayer, config, the click
        // listener) runs immediately and queues into dataLayer, which is
        // exactly what that array is for: hits recorded before the library
        // arrives are replayed in order once it loads. So deferring the fetch
        // costs no EVENTS, only the moment they reach Google.
        var loaded = false;
        function loadGtag() {
          if (loaded) return;
          loaded = true;
          var s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
          document.head.appendChild(s);
        }

        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', id);

        // Engagement events, one delegated listener for the whole page.
        // Capture phase so handlers that stop propagation (e.g. the Expressive
        // Code copy button) can't swallow the click before we see it.
        document.addEventListener(
          'click',
          function (e) {
            var t = e.target instanceof Element ? e.target : null;
            if (!t) return;
            if (t.closest('.expressive-code .copy button')) {
              gtag('event', 'copy_code', { page_path: location.pathname });
              return;
            }
            var a = t.closest('a[href]');
            if (!a) return;
            if (/github\.com\/knomit/.test(a.href)) {
              gtag('event', 'github_click', {
                link_url: a.href,
                placement: a.closest('header')
                  ? 'header'
                  : a.closest('footer')
                    ? 'footer'
                    : 'body',
              });
            } else if (a.pathname === '/rss.xml') {
              gtag('event', 'rss_click', { placement: 'footer' });
            } else if (a.classList.contains('k-btn')) {
              gtag('event', 'cta_click', {
                link_url: a.href,
                link_text: (a.textContent || '').trim().slice(0, 60),
              });
            }
          },
          true
        );

        // Fetch the library once the main thread is free. The timeout is the
        // safety net: without it, a page that never goes idle never reports.
        if (typeof window.requestIdleCallback === 'function') {
          window.requestIdleCallback(loadGtag, { timeout: 2000 });
        } else {
          setTimeout(loadGtag, 1200);
        }

        // Honest limitation: a visitor who leaves inside that window takes the
        // queue with them, so very short visits can go uncounted. Flushing when
        // the page is hidden recovers the common cases (tab switch, back
        // button); a hard close during the first 2s is still lost. That is the
        // price of not putting 167 KB on the critical path.
        document.addEventListener('visibilitychange', function () {
          if (document.visibilityState === 'hidden') loadGtag();
        });
      })();
    </script>
  )
}
