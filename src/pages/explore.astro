---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreBrowser from '../components/ExploreBrowser.tsx';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import Icon from '../components/Icon.astro';
import { GITHUB_URL } from '../lib/site';
---

<BaseLayout title="Explore — knomit" description="Browse a live knomit knowledge base: typed facts, provenance, and full history.">
  <section class="explore-live">
    <div class="k-container">
      <div class="explore-live__frame">
        <ExploreBrowser client:only="react" />
      </div>
    </div>
  </section>

  <!-- The server-rendered default: visible with no JS, to a crawler, or if
       the island's mount fails. ExploreBrowser.tsx adds `explore-js` to
       <body> as soon as it mounts (hiding this and revealing .explore-live),
       then `explore-fallback` on top of that if the bundle fetch fails or
       times out (reverting back to this). -->
  <section class="explore-teaser k-grid-bg" data-testid="explore-teaser">
    <div class="k-container explore-teaser__inner">
      <div class="explore-teaser__copy">
        <p class="k-eyebrow">Live knowledge base</p>
        <h1 class="explore-teaser__title">The live knowledge base couldn't be loaded right now.</h1>
        <p class="k-lead explore-teaser__lead">
          /explore runs the real knomit web UI in your browser — browse,
          search, and inspect a fact's provenance and history — against a
          public, read-only knomit knowledge base. Refresh to try again, or
          read on: everything it shows is covered below too.
        </p>
        <div class="explore-teaser__cta">
          <a href="/docs/quick-start" class="k-btn">Run it yourself <Icon name="arrow" size={17} /></a>
          <a href={GITHUB_URL} class="k-btn k-btn--ghost" rel="noopener">View on GitHub</a>
        </div>
        <ul class="explore-teaser__list">
          <li><Icon name="search" size={17} /> Library &amp; semantic search over real facts</li>
          <li><Icon name="provenance" size={17} /> Inspect a fact's signed-commit provenance</li>
          <li><Icon name="temporal" size={17} /> Time-travel the graph to any past commit</li>
        </ul>
      </div>
      <div class="explore-teaser__art">
        <KnowledgeGraph />
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .explore-teaser {
    padding-block: clamp(3rem, 2rem + 6vw, 7rem);
  }
  .explore-teaser__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
  }
  .explore-teaser__title {
    font-size: var(--k-step-h1);
    margin: 0.4rem 0 0;
  }
  .explore-teaser__lead {
    margin-top: 1.25rem;
    max-width: 38rem;
  }
  .explore-teaser__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .explore-teaser__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .explore-teaser__list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--k-text-2);
    font-size: 0.96rem;
  }
  .explore-teaser__list .k-icon {
    color: var(--k-brand);
    flex-shrink: 0;
  }
  .explore-teaser__art {
    max-width: 420px;
    margin-inline: auto;
  }
  @media (max-width: 860px) {
    .explore-teaser__inner {
      grid-template-columns: 1fr;
    }
    .explore-teaser__art {
      order: -1;
      max-width: 320px;
    }
  }

  .explore-live {
    padding-block: clamp(2rem, 1.5rem + 3vw, 4rem);
  }
  .explore-live__frame {
    height: min(80vh, 900px);
    min-height: 520px;
    border: 1px solid var(--k-hairline);
    border-radius: var(--k-radius);
    overflow: hidden;
    background: #0b0b0b;
  }
  /* Server-rendered default: teaser visible, live frame hidden — this is
     what a crawler or a no-JS visitor sees, and it's also what paints first
     for everyone else (the island mounts `client:only`, after the page's own
     JS loads). ExploreBrowser.tsx flips `explore-js` on <body> in a
     layout effect on its very first mount — before the browser's next paint,
     whatever `load` phase it's in — so the swap to the live frame happens as
     early as the mount itself, not after the bundle fetch resolves; that's
     what keeps this from flashing into view once JS has taken over. */
  .explore-teaser {
    display: block;
  }
  .explore-live {
    display: none;
  }
  body.explore-js .explore-teaser {
    display: none;
  }
  body.explore-js .explore-live {
    display: block;
  }
  /* Bundle fetch failed or timed out: revert to the teaser regardless of
     explore-js. Rule order (after the explore-js rules above), not extra
     specificity, is what makes this win when both classes are present. */
  body.explore-fallback .explore-teaser {
    display: block;
  }
  body.explore-fallback .explore-live {
    display: none;
  }

  /* ── ExploreBrowser layout ──────────────────────────────────────────────
     ExploreBrowser.tsx renders its own layout with these class names (and no
     inline layout styles of its own) so the responsive rules below — real
     @media queries — can reach it; a React inline `style` object can't
     express a breakpoint. Below the site's own 860px breakpoint (the same
     one .explore-teaser__inner uses above), library + content + rail can't
     hold side by side: a dragged/default library width plus the rail's fixed
     300px leaves the fact panel a sliver or negative width on a phone. Stack
     instead — library, then the filter bar + fact panel, then the
     connections rail — each given a real (vh, not %) height so the vendored
     panels' own `height: 100%` internals still resolve, and the frame itself
     scrolls through them. Nothing is ever unreachable; there's just more of
     it below the fold. */
  .explore-frame {
    display: flex;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    outline: none;
  }
  .explore-frame__left {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .explore-frame__splitter {
    width: 4px;
    margin-left: -2px;
    margin-right: -2px;
    cursor: ew-resize;
    flex-shrink: 0;
    z-index: 1;
    background: transparent;
    border-left: 1px solid var(--k-hairline);
  }
  .explore-frame__splitter:hover {
    background: rgba(119, 204, 153, 0.15);
  }
  .explore-frame__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-left: 1px solid var(--k-hairline);
  }
  .explore-frame__body {
    flex: 1;
    min-height: 0;
    display: flex;
    overflow: hidden;
  }
  .explore-frame__content {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .explore-frame__rail {
    /* EdgesRail's own vendored root is a hardcoded `width: 300` box — this
       wrapper just gives it a slot to sit in and a definite height so its
       `height: 100%` resolves; it does not (and, given the vendored fixed
       width, cannot) stretch the rail itself. */
    width: 300px;
    flex-shrink: 0;
    display: flex;
    min-height: 0;
  }

  @media (max-width: 860px) {
    .explore-frame {
      flex-direction: column;
      overflow-y: auto;
      overflow-x: hidden;
    }
    /* Every stacked section below gets `flex: 0 0 auto` — its OWN explicit
       (vh) height, not a share of the parent's. .explore-frame__main and
       .explore-frame__body inherit `flex: 1` from the desktop (row) rules
       above; left as flex:1, each nests one level deeper than .explore-frame
       itself, so their "remaining space" is computed from an ALREADY-SHRUNK
       ancestor rather than the frame's full height — content's flex-basis:0%
       then has nothing left to grow into once its sibling rail's explicit
       height is subtracted, and it collapses to 0 (reproducing this same
       finding one level down). Switching every section to auto-sized content
       stacked in a plain scrolling column sidesteps the arithmetic entirely:
       each one is exactly as tall as its own rule says, and the frame's
       overflow-y:auto scrolls through the (correctly) taller-than-the-box
       total, the same way the library's and rail's internal scroll already
       work today. */
    .explore-frame__left {
      width: 100% !important;
      height: 46vh;
      flex: 0 0 auto;
    }
    .explore-frame__splitter {
      display: none;
    }
    .explore-frame__main {
      width: 100%;
      flex: 0 0 auto;
      border-left: none;
      border-top: 1px solid var(--k-hairline);
    }
    .explore-frame__body {
      flex-direction: column;
      flex: 0 0 auto;
    }
    .explore-frame__content {
      width: 100%;
      height: 46vh;
      flex: 0 0 auto;
    }
    .explore-frame__rail {
      width: 100% !important;
      height: 36vh;
      flex: 0 0 auto;
    }
  }
</style>
