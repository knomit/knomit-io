---
import BaseLayout from '../layouts/BaseLayout.astro';
import ExploreBrowser from '../components/ExploreBrowser.tsx';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import Icon from '../components/Icon.astro';
import { GITHUB_URL } from '../lib/site';
---

<BaseLayout title="Explore — knomit" description="Browse a live knomit knowledge base: typed facts, provenance, and full history.">
  <!-- Without JS the island never mounts, so the frame would be an empty box.
       Swap to the teaser for exactly that audience — no-JS visitors and the
       non-JS-executing crawlers robots.txt welcomes — without making anyone
       with JS watch a flash. The teaser's markup is in the document either
       way, so its text is indexable regardless of how this resolves. -->
  <noscript>
    <style>
      .explore-live { display: none !important; }
      .explore-teaser { display: block !important; }
    </style>
  </noscript>

  <!-- Full-bleed by design: no .k-container. The browser is an application
       surface, not page copy, so it takes the whole viewport width and the
       whole height below the sticky header. The teaser below keeps the
       site's normal container. -->
  <section class="explore-live">
    <h1 class="explore-live__srtitle">Browse a live knomit knowledge base.</h1>
    <div class="explore-live__frame">
      <ExploreBrowser client:only="react" />
    </div>
  </section>

  <!-- The server-rendered default: visible with no JS, to a crawler, or for
       the moment before the island mounts — which is most of every real
       visit too, since the island is `client:only`. ExploreBrowser.tsx adds
       `explore-js` to <body> as soon as it mounts (hiding this and
       revealing .explore-live), then `explore-fallback` on top of that if
       the bundle fetch fails or times out (reverting back to this). Because
       this is the *default*, not just a failure state, its title and lead
       describe the feature; `.explore-teaser__error` below is the only part
       that reads as a failure, and it only renders under
       body.explore-fallback. -->
  <section class="explore-teaser k-grid-bg" data-testid="explore-teaser">
    <div class="k-container explore-teaser__inner">
      <div class="explore-teaser__copy">
        <p class="k-eyebrow">Live knowledge base</p>
        <h1 class="explore-teaser__title">Browse a live knomit knowledge base.</h1>
        <p class="k-lead explore-teaser__lead">
          /explore runs the real knomit web UI in your browser — browse,
          search, and inspect a fact's provenance and history — against a
          public, read-only knomit knowledge base.
        </p>
        <p class="explore-teaser__error" data-testid="explore-teaser-error">
          The live knowledge base couldn't be loaded right now. Refresh to
          try again, or read on: everything it shows is covered below too.
        </p>
        <div class="explore-teaser__cta">
          <a href="/docs/quick-start" class="k-btn">Run it yourself <Icon name="arrow" size={17} /></a>
          <a href={GITHUB_URL} class="k-btn k-btn--ghost" rel="noopener">View on GitHub</a>
        </div>
        <ul class="explore-teaser__list">
          <li><Icon name="search" size={17} /> Library &amp; semantic search over real facts</li>
          <li><Icon name="provenance" size={17} /> Inspect a fact's signed-commit provenance</li>
          <li><Icon name="temporal" size={17} /> Time-travel the graph to any past commit</li>
        </ul>
      </div>
      <div class="explore-teaser__art">
        <KnowledgeGraph />
      </div>
    </div>
  </section>
</BaseLayout>

<style is:global>
  .explore-teaser {
    padding-block: clamp(3rem, 2rem + 6vw, 7rem);
  }
  .explore-teaser__inner {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
  }
  .explore-teaser__title {
    font-size: var(--k-step-h1);
    margin: 0.4rem 0 0;
  }
  .explore-teaser__lead {
    margin-top: 1.25rem;
    max-width: 38rem;
  }
  /* Only true on the degraded path (see body.explore-fallback below): the
     default teaser — seen with no JS, by a crawler, or during the moment
     before the island mounts — describes the feature, not a failure. */
  .explore-teaser__error {
    display: none;
    margin-top: 1.25rem;
    max-width: 38rem;
    color: var(--k-text-2);
  }
  .explore-teaser__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .explore-teaser__list {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .explore-teaser__list li {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--k-text-2);
    font-size: 0.96rem;
  }
  .explore-teaser__list .k-icon {
    color: var(--k-brand);
    flex-shrink: 0;
  }
  .explore-teaser__art {
    max-width: 420px;
    margin-inline: auto;
  }
  @media (max-width: 860px) {
    .explore-teaser__inner {
      grid-template-columns: 1fr;
    }
    .explore-teaser__art {
      order: -1;
      max-width: 320px;
    }
  }

  /* No padding-block: the frame butts directly against the header above and
     the footer below, so every pixel between them belongs to the app. */
  .explore-live {
    padding-block: 0;
  }
  /* The site's footer carries a 64px top margin, which reads as dead space
     under a full-bleed app surface. This style block only ships on /explore,
     so scoping it further isn't needed — but it is restored when the teaser
     is showing, since there the footer follows ordinary page copy. */
  body:not(.explore-fallback) footer {
    margin-top: 0;
  }
  /* Fills the viewport below the sticky header. --k-header-h is a fallback;
     ExploreBrowser measures the real header on mount and overwrites it, so a
     header that grows (an extra nav item wrapping) can't silently clip or
     over-extend the frame. `dvh` so mobile browser chrome collapsing doesn't
     leave a gap. */
  .explore-live__frame {
    height: calc(100dvh - var(--k-header-h, 61px));
    min-height: 520px;
    border-top: 1px solid var(--k-hairline);
    border-bottom: 1px solid var(--k-hairline);
    overflow: hidden;
    background: #0b0b0b;
  }
  /* The live frame is the DEFAULT paint — no class toggle, no flash. Earlier
     this was inverted (teaser first, island swaps it) to guarantee crawlable
     text, but that made every visitor watch the teaser for the length of the
     island's JS download: ~0.6s on Fast 4G, ~5.9s on Slow 3G, measured. The
     <noscript> block below buys back the no-JS and non-JS-crawler case
     without costing everyone else a flash. */
  .explore-teaser {
    display: none;
  }
  .explore-live {
    display: block;
  }
  /* Bundle fetch failed or timed out: swap to the teaser. Rule order, not
     specificity, is what makes this win. */
  body.explore-fallback .explore-teaser {
    display: block;
  }
  body.explore-fallback .explore-live {
    display: none;
  }
  /* The live view's heading. The page needs an <h1> even when the teaser
     (which carries the visible one) is hidden — for the document outline and
     for a JS-executing crawler. */
  .explore-live__srtitle {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  /* The failure sentence only ever appears alongside explore-fallback —
     never on a successful load, and never in what a no-JS visitor or
     crawler sees by default. */
  body.explore-fallback .explore-teaser__error {
    display: block;
  }

  /* ── ExploreBrowser layout ──────────────────────────────────────────────
     ExploreBrowser.tsx renders its own layout with these class names (and no
     inline layout styles of its own) so the responsive rules below — real
     @media queries — can reach it; a React inline `style` object can't
     express a breakpoint. Below the site's own 860px breakpoint (the same
     one .explore-teaser__inner uses above), library + content + rail can't
     hold side by side: a dragged/default library width plus the rail's fixed
     300px leaves the fact panel a sliver or negative width on a phone. Stack
     instead — library, then the filter bar + fact panel, then the
     connections rail — each given a real (vh, not %) height so the vendored
     panels' own `height: 100%` internals still resolve, and the frame itself
     scrolls through them. Nothing is ever unreachable; there's just more of
     it below the fold. */
  .explore-frame {
    display: flex;
    height: 100%;
    min-height: 0;
    overflow: hidden;
    outline: none;
  }
  .explore-frame__left {
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }
  .explore-frame__splitter {
    width: 4px;
    margin-left: -2px;
    margin-right: -2px;
    cursor: ew-resize;
    flex-shrink: 0;
    z-index: 1;
    background: transparent;
    border-left: 1px solid var(--k-hairline);
  }
  .explore-frame__splitter:hover {
    background: rgba(119, 204, 153, 0.15);
  }
  .explore-frame__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-left: 1px solid var(--k-hairline);
  }
  .explore-frame__body {
    flex: 1;
    min-height: 0;
    display: flex;
    overflow: hidden;
  }
  .explore-frame__content {
    flex: 1;
    min-width: 0;
    overflow: hidden;
  }
  .explore-frame__rail {
    flex-shrink: 0;
    display: flex;
    min-height: 0;
  }
  /* EdgesRail's vendored root is a hardcoded inline `width: 300`. We can't
     edit it — that's the invariant this whole design protects — but we can
     override it from our own stylesheet, which is not the same thing as
     hand-editing the file: `npm run sync` regenerates the component and this
     rule keeps applying. It's already `box-sizing: border-box`, so 100% of
     the wrapper is exactly right. Without this the rail stays 300px however
     wide the user drags its splitter. */
  .explore-frame__rail > * {
    width: 100% !important;
  }
  /* Write controls. The shell deliberately does NOT set serverReadOnly (see
     ExploreBrowser.tsx for why — it would also disable click-to-filter), so
     the vendored panels render their edit affordances as if writes were
     possible. They aren't: bundleApi's updateFact/retractFact throw, and
     there is no server to write to. Hide them here rather than by editing a
     vendored file. `display: none` (not just pointer-events) so they leave
     the accessibility tree too, and keyboard users can't reach a control
     that would only ever produce an error. */
  .explore-frame [data-testid='retract-btn'],
  .explore-frame [data-testid='retract-confirm-btn'],
  .explore-frame [data-testid='fact-save-btn'] {
    display: none !important;
  }

  @media (max-width: 860px) {
    .explore-frame {
      flex-direction: column;
      overflow-y: auto;
      overflow-x: hidden;
    }
    /* Every stacked section below gets `flex: 0 0 auto` — its OWN explicit
       (vh) height, not a share of the parent's. .explore-frame__main and
       .explore-frame__body inherit `flex: 1` from the desktop (row) rules
       above; left as flex:1, each nests one level deeper than .explore-frame
       itself, so their "remaining space" is computed from an ALREADY-SHRUNK
       ancestor rather than the frame's full height — content's flex-basis:0%
       then has nothing left to grow into once its sibling rail's explicit
       height is subtracted, and it collapses to 0 (reproducing this same
       finding one level down). Switching every section to auto-sized content
       stacked in a plain scrolling column sidesteps the arithmetic entirely:
       each one is exactly as tall as its own rule says, and the frame's
       overflow-y:auto scrolls through the (correctly) taller-than-the-box
       total, the same way the library's and rail's internal scroll already
       work today. */
    .explore-frame__left {
      width: 100% !important;
      height: 46vh;
      flex: 0 0 auto;
    }
    .explore-frame__splitter {
      display: none;
    }
    .explore-frame__main {
      width: 100%;
      flex: 0 0 auto;
      border-left: none;
      border-top: 1px solid var(--k-hairline);
    }
    .explore-frame__body {
      flex-direction: column;
      flex: 0 0 auto;
    }
    .explore-frame__content {
      width: 100%;
      height: 46vh;
      flex: 0 0 auto;
    }
    .explore-frame__rail {
      width: 100% !important;
      height: 36vh;
      flex: 0 0 auto;
    }
  }
</style>
