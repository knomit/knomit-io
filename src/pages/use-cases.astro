---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { GITHUB_URL, DEMO_LIVE } from '../lib/site';

const groups = [
  {
    eyebrow: 'For researchers & analysts',
    lead: 'A corpus that gets sharper with every review pass, about any field.',
    cases: [
      {
        icon: 'search',
        title: 'Research & intelligence monitoring',
        body: 'Point agents at sources and they write what they find as typed facts with the URL that backs each one. The public agentic-engineering knowledge base works this way: hundreds of web-sourced facts on agent security, evaluation, reliability and MCP. A second public knowledge base covers AI and cybersecurity.',
        tag: 'web-sourced · typed · refs to every source',
        link: DEMO_LIVE ? { href: '/explore/', label: 'Browse the agentic-engineering KB' } : undefined,
      },
      {
        icon: 'discovery',
        title: 'Hypothesis-driven research',
        body: 'Observations distill into syntheses; syntheses extend into falsifiable hypotheses with the criteria that would settle them. When the evidence arrives, the outcome is recorded as a commit, so you can see exactly when a question was closed.',
        tag: 'observe → synthesize → hypothesize → settle',
        link: { href: '/concepts/#synthesis', label: 'Synthesis & hypotheses' },
      },
      {
        icon: 'cluster',
        title: 'Patterns across subjects',
        body: 'Facts can name their motif, the general mechanism or failure shape they instantiate. An analyst can then ask for every fact, in any knowledge base a lens mounts, that follows the same pattern as the one in front of them, whatever its subject.',
        tag: 'motifs · lenses · cross-subject',
        link: { href: '/docs/lenses/', label: 'Lenses' },
      },
    ],
  },
  {
    eyebrow: 'For teams',
    lead: 'One body of knowledge that people and agents build together.',
    cases: [
      {
        icon: 'consensus',
        title: 'Distributed team knowledge',
        body: 'Each person and each agent writes on its own branch; facts reach main by review or by automatic merge. Because facts are plain markdown in git, you can review knowledge in pull requests and check where a claim came from instead of trusting whoever said it last.',
        tag: 'author together · review like code',
        link: { href: '/docs/sync-and-consensus/', label: 'Sync, consensus and conflicts' },
      },
      {
        icon: 'provenance',
        title: 'Decisions that keep their reasons',
        body: 'When an agent or a colleague resolves a tradeoff, it records the options, the rationale and the choice as a typed, signed fact. The next participant reads why instead of re-deriving it, and can see exactly what was known when the choice was made.',
        tag: 'decisions · rationale · signed',
      },
      {
        icon: 'distributed',
        title: 'Open knowledge networks',
        body: 'A public knomit repository anyone can contribute to by pull request, or subscribe to read-only. Every fact keeps its provenance, and deduplication means the network pays for each piece of learning once.',
        tag: 'public repo · subscribe · paid once',
      },
      {
        icon: 'markdown',
        title: 'Publish knowledge as an open standard',
        body: 'Export the whole base to Open Knowledge Format — Google Cloud\'s open spec — and push it to any git host. Consumers read plain markdown with standard frontmatter, with no knomit anywhere in the picture. Your agent-shaped base stays where it is; what you publish is portable and belongs to no vendor.',
        tag: 'OKF 0.2 · conformance-validated · one git URL',
        link: { href: '/okf/', label: 'How OKF export works' },
      },
    ],
  },
  {
    eyebrow: 'For operators',
    lead: 'Several machines, one piece of work, one converging truth.',
    cases: [
      {
        icon: 'evolve',
        title: 'Coordinated work across machines',
        body: 'A mission repository holds the tasks and the coordination signals; the knowledge the work produces goes to a separate target knowledge base. Triggers on each machine claim tasks as they appear, a recipe starts an agent session to work each one, and the results reach the target’s main by consensus, each commit signed by the machine that made it. The mission template ships these pieces ready to adapt.',
        tag: 'mission repo · target KB · triggers · signed consensus',
        link: { href: '/docs/triggers/', label: 'Triggers and recipes' },
      },
      {
        icon: 'cluster',
        title: 'A fleet of instances',
        body: 'Register each instance with a fleet repository whose member records are the admitted set. Instances host repositories for each other over mutual TLS, sync in real time, and with verification on accept into main only commits signed by an active member’s current key.',
        tag: 'fleet repo · mTLS hosting · verified acceptance',
        link: { href: '/docs/fleet/', label: 'Fleets' },
      },
      {
        icon: 'consensus',
        title: 'Competitive agent runs',
        body: 'Point several agents at one task. Each records its approach and findings on its own branch, and all of it converges in one repository. Review then distills where the approaches agreed, where their confidence diverged, and what only one agent found: an account of why, not just a leaderboard.',
        tag: 'per-branch findings · distilled comparison',
      },
      {
        icon: 'mcp',
        title: 'Staged processing with triggers',
        body: 'A trigger on one knowledge base can run a recipe when facts land there, and the recipe can start an agent session that reads them and writes what it concludes into a separate target knowledge base. Each knowledge base in the chain can be queried on its own, and a lens can read several as one.',
        tag: 'triggers · recipes · target KB',
        link: { href: '/docs/triggers/', label: 'Triggers and recipes' },
      },
      {
        icon: 'fact',
        title: 'Offline-first & edge agents',
        body: 'Every instance holds its knowledge bases locally as git repositories. An agent in the field, airgapped, or simply disconnected keeps full recall and keeps learning on its branch, then syncs when it reconnects. The network is for consensus, not for access.',
        tag: 'local-first · works disconnected · syncs later',
      },
    ],
  },
  {
    eyebrow: 'For developers & their coding agents',
    lead: 'A codebase is one more domain.',
    cases: [
      {
        icon: 'ontology',
        title: 'Codebase tribal knowledge',
        body: 'Invariants, gotchas, and design rationale that never make it into comments. Your coding agent — and your teammates — read them before touching an area, and write new ones when they discover something non-obvious. Facts can pin the exact source they describe, so a stale one shows.',
        tag: 'invariants · gotchas · decisions',
        link: { href: '/docs/claude-code/', label: 'Wire it into Claude Code' },
      },
      {
        icon: 'temporal',
        title: 'Facts that wait for the merge',
        body: 'Facts about code going out in a pull request can be written in an experiment named after the branch. If the change merges, the experiment commits; if it is abandoned, the facts roll back with it and never reach anyone else.',
        tag: 'experiments · commit or roll back',
        link: { href: '/docs/experiments/', label: 'Experiments' },
      },
      {
        icon: 'discovery',
        title: 'Surface hidden invariants before they bite',
        body: 'Run hypothesize at medium or high effort to discover emergent keystones: the load-bearing premises that underwrite facts across your codebase but were never written down. knomit ranks them by blast radius, how much breaks if the premise is false.',
        tag: 'discovery · keystones · blast radius',
      },
    ],
  },
];
---

<BaseLayout
  title="Use cases — a knowledge distillation factory for agents, teams and research"
  description="Use cases for a knowledge distillation factory: research and analysis corpora, team knowledge, coordinated work across machines, codebases, and OKF publishing."
>
  <section class="k-section uc-hero k-grid-bg">
    <div class="k-container">
      <SectionHeading
        as="h1"
        eyebrow="Use cases"
        title="Where shared, distilled knowledge pays off."
        lead="The same fabric serves an analyst with a research corpus, a team, an operator running work across several machines, and a developer with a codebase. Here is what people build with it."
      />
    </div>
  </section>

  {
    groups.map((group) => (
      <section class="k-section uc-group">
        <div class="k-container">
          <header class="uc-group__head">
            <p class="k-eyebrow">{group.eyebrow}</p>
            <p class="uc-group__lead">{group.lead}</p>
          </header>
          <div class="uc-grid">
            {group.cases.map((c) => (
              <article class="k-card uc-card k-reveal">
                <span class="uc-card__icon">
                  <Icon name={c.icon as any} size={22} />
                </span>
                <h2 class="uc-card__title">{c.title}</h2>
                <p class="uc-card__body k-text-2">{c.body}</p>
                <p class="uc-card__tag k-mono">{c.tag}</p>
                {c.link && (
                  <a href={c.link.href} class="uc-card__link">
                    {c.link.label} <Icon name="arrow" size={15} />
                  </a>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="k-section">
    <div class="k-container uc-cta">
      <h2>Have a use case of your own?</h2>
      <p class="k-lead">It's source-available and free to self-host. Start a knowledge base from a template, point your agents at it, and see.</p>
      <div class="uc-cta__actions">
        <a href={GITHUB_URL} class="k-btn" rel="noopener">View on GitHub</a>
        <a href="/docs/quick-start/" class="k-btn k-btn--ghost">Quick start</a>
        <a href="/docs/templates/" class="k-btn k-btn--ghost">Templates</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .uc-hero {
    border-bottom: 1px solid var(--k-hairline-soft);
    padding-block: clamp(3rem, 2rem + 4vw, 4.5rem) 1rem;
  }
  .uc-hero :global(.k-heading) {
    margin-bottom: 0;
  }
  .uc-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.25rem;
  }
  .uc-card {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
  }
  .uc-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 11px;
    color: var(--k-brand);
    background: var(--k-brand-glow);
    border: 1px solid rgba(119, 204, 153, 0.25);
    margin-bottom: 1.1rem;
  }
  .uc-card__title {
    font-size: 1.4rem;
    margin-bottom: 0.7rem;
  }
  .uc-card__body {
    line-height: 1.6;
    font-size: 0.96rem;
  }
  .uc-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0;
    padding-top: 0.5rem;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .uc-group {
    padding-block: clamp(2rem, 1.25rem + 3vw, 3.25rem);
  }
  .uc-group + .uc-group {
    padding-top: 0;
  }
  .uc-group__head {
    margin-bottom: 1.5rem;
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--k-hairline-soft);
  }
  .uc-group__lead {
    font-size: 1.15rem;
    color: var(--k-text);
    margin-top: 0.3rem;
  }
  .uc-card__tag {
    margin-top: auto;
    padding-top: 1rem;
    font-size: 0.76rem;
    color: var(--k-text-muted);
    letter-spacing: 0.01em;
  }
  /* When a card has both a tag and a link, the tag shouldn't eat the spacer */
  .uc-card__tag + .uc-card__link {
    margin-top: 0.6rem;
    padding-top: 0;
  }

  .uc-cta {
    text-align: center;
  }
  .uc-cta h2 {
    font-size: var(--k-step-h2);
    margin-bottom: 0.8rem;
  }
  .uc-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
    margin-top: 1.75rem;
  }
</style>
