---
import BaseLayout from '../layouts/BaseLayout.astro';
import KnowledgeGraph from '../components/KnowledgeGraph.astro';
import FragmentedKnowledge from '../components/FragmentedKnowledge.astro';
import SectionHeading from '../components/SectionHeading.astro';
import FactCard from '../components/FactCard.astro';
import FeatureGrid from '../components/FeatureGrid.astro';
import BlogCard from '../components/BlogCard.astro';
import Icon from '../components/Icon.astro';
import { GITHUB_URL, SITE_DESCRIPTION_SHORT, DEMO_LIVE } from '../lib/site';
import { getPublishedPosts, postHref } from '../lib/blog';
import { HOME_FAQ_ITEMS } from '../lib/faq';

const posts = (await getPublishedPosts()).slice(0, 3);

// The page follows the fabric statement (kb principle "knowledge distillation
// fabric"): the problem, then the factory's three verbs — accumulate, distill,
// use — then git as the mechanism. Every card below is a capability that
// exists in knomit dev; the goal itself is not claimed as shipped.

// ACCUMULATE: how what one agent learns gets into the shared corpus.
const accumulate = [
  {
    icon: 'fact',
    title: 'Typed facts, not documents',
    body: 'An agent writes what it learned as one atomic claim in plain markdown, with a kind, a type, a confidence, an ontology path and refs. A near-duplicate folds into the fact that already exists instead of becoming a second copy.',
  },
  {
    icon: 'provenance',
    title: 'Signed, on the agent’s own branch',
    body: 'Every write is one signed git commit on the writing agent’s branch, never on main. The agent’s id is assigned when its instance first starts and kept from then on, so everything it asserted stays attributable to it.',
  },
  {
    icon: 'distributed',
    title: 'Sync on an interval or in real time',
    body: 'Instances fetch, merge and push on a schedule, or in real time when a repository asks for it, behind circuit breakers. A knomit instance can host a repository itself: peers push their agent branches to it over mutual TLS.',
  },
  {
    icon: 'consensus',
    title: 'Consensus on main',
    body: 'Facts reach main through a reviewed merge, or automatically: with consensus set to auto, the hosting instance merges every branch a peer pushes. Where two agents edited the same fact, the merge can settle it field by field, and records how.',
  },
  {
    icon: 'cluster',
    title: 'A fleet of machines',
    body: 'Instances register with a fleet repository whose member records are the admitted set. With verification on, a commit is accepted into main only when an active member signed it with its current key.',
  },
  {
    icon: 'ontology',
    title: 'Any domain, many knowledge bases',
    body: 'One instance serves many knowledge bases, each with its own ontology: a codebase, a research field, a market, a mission. The same fact model holds all of them.',
  },
];

// DISTILL: what keeps accumulation from becoming a bigger pile.
const distill = [
  {
    icon: 'dedup',
    title: 'Review: prune, distill, reflect',
    body: 'A review pass merges what is redundant and retires what is stale, distills syntheses that no single source states, and reflects on the method that produced them. Each distilled fact cites the facts it came from.',
  },
  {
    icon: 'discovery',
    title: 'Hypotheses you can settle',
    body: 'Hypothesize extends syntheses forward into falsifiable predictions with the criteria that would settle them. When the evidence arrives, the outcome is a commit like any other.',
  },
  {
    icon: 'evolve',
    title: 'Discovery of unwritten keystones',
    body: 'An effort dial on review and hypothesize starts from bridges: facts that share a domain or entity but sit in different similarity clusters. It proposes the keystone those bridges imply and marks it as discovered.',
  },
  {
    icon: 'cluster',
    title: 'Motifs across subjects',
    body: 'A fact can name its motif: the general mechanism or failure shape it instantiates, independent of its subject. Facts about unrelated subjects that follow the same pattern can then be found together, across every knowledge base a lens mounts.',
  },
  {
    icon: 'kinds',
    title: 'Guidance per corpus',
    body: 'An ontology can carry guidance for review and hypothesize, for the whole knowledge base or one topic, so a security corpus and a codebase are distilled by their own standards.',
  },
  {
    icon: 'consensus',
    title: 'Disagreements settled, not lost',
    body: 'When two agents changed the same fact, a field-by-field merge keeps each side’s independent edits and settles a field both changed by confidence, then by sources. The version it set aside stays readable in the merge’s history.',
  },
];

// USE: how distilled knowledge flows back into work.
const use = [
  {
    icon: 'mcp',
    title: 'Query and explain over MCP',
    body: 'Twelve MCP tools for any MCP client: query by text, entity, domain, type or motif; explain a fact by walking its provenance as of any commit; follow what changed since a bookmark. Integrations exist for Claude Code, Antigravity and Claude Desktop.',
  },
  {
    icon: 'search',
    title: 'Lenses',
    body: 'A lens mounts several knowledge bases, including ones that sync from other machines, and queries them as one. Writes through a lens go to the one repository it names for writing.',
  },
  {
    icon: 'markdown',
    title: 'Skills and templates',
    body: 'A knowledge base can carry its own skills, served to agents as MCP prompts. New knowledge bases start from templates (general, coding, mission, fleet) kept in a playbooks repository you subscribe to.',
  },
  {
    icon: 'evolve',
    title: 'Triggers and recipes',
    body: 'A topic can declare triggers that fire when facts are learned, updated, retracted or fall due. A trigger can run a script, push at once, or run a recipe: a script kept on main or on the machine that can start a process, such as an agent session.',
  },
  {
    icon: 'temporal',
    title: 'Experiments',
    body: 'An agent can open an experiment: a local branch forked from its own, where it learns and reviews as usual. Commit merges the whole thing back; rollback discards it. Experiments are never pushed.',
  },
  {
    icon: 'api',
    title: 'Web UI and REST',
    body: 'People read the same corpus agents do: browse the ontology, search, read a fact as it stood at any commit, and merge pushed branches in the web UI, or script it over a HAL+JSON REST API.',
  },
];

// The anatomy of the fact on the card — what each part means.
const factTraits = [
  { icon: 'kinds', text: 'A kind — epistemic (what is) or pragmatic (what to do) — so a consumer knows how to apply it.' },
  { icon: 'temporal', text: 'A confidence — a degree of belief, not a true/false flag.' },
  { icon: 'evolve', text: 'An origin — authored, distilled, or discovered — recording whether it was written, synthesized, or inferred by knomit itself.' },
  { icon: 'ontology', text: 'An ontology path, domains, and entities — what it’s about, and where it lives.' },
  { icon: 'provenance', text: 'Refs — to its sources and to other facts, forming the graph.' },
  { icon: 'markdown', text: 'One claim, in plain markdown — human- and machine-writable, diffable in git.' },
];

// Git as the mechanism. Wording follows the knomit README's table.
const gitOps = [
  { op: 'commit', means: 'a signed assertion of belief' },
  { op: 'branch', means: 'an agent’s identity' },
  { op: 'merge', means: 'consensus' },
  { op: 'conflict', means: 'a disagreement surfaced to be settled' },
  { op: 'log', means: 'the timeline of what the fabric believed, and when' },
];
---

<BaseLayout
  title="knomit — a distributed knowledge distillation factory for agents"
  description={SITE_DESCRIPTION_SHORT}
>
  <!-- Hero -->
  <section class="hero k-grid-bg">
    <div class="k-container hero__inner">
      <div class="hero__copy">
        <p class="k-eyebrow">Knowledge distillation factory · Knowledge + commit</p>
        <h1 class="hero__title">Learn it once.<br />Everywhere knows.</h1>
        <p class="k-lead hero__lead">
          <strong>knomit is a distributed, decentralized knowledge distillation
          factory.</strong> It connects many agents and many knowledge bases so
          that what any one of them learns is accumulated, distilled and put to
          use by all of them. Learning is paid for once across the network,
          instead of once per agent.
        </p>
        {/* Two actions, deliberately. The hero column is ~520px, so a third
            button wraps to a second row and the primary action stops reading
            as primary. GitHub is not lost: it sits in the header on every
            page, and closes this one in the final CTA below. */}
        <div class="hero__cta">
          <a href="/download/" class="k-btn">
            <Icon name="arrow" size={17} /> Download knomit
          </a>
          <a href="/docs/quick-start/" class="k-btn k-btn--ghost">
            Quick start <Icon name="arrow" size={17} />
          </a>
        </div>
        <p class="hero__sub k-mono k-muted">
          accumulate · distill · use — typed facts, signed commits, git
        </p>
      </div>
      <div class="hero__art">
        <KnowledgeGraph />
      </div>
    </div>
  </section>

  <!-- Problem -->
  <section class="k-section problem-section">
    <div class="k-container">
      <div class="problem-head">
        <div class="k-prose">
          <SectionHeading
            eyebrow="The problem"
            title="What one agent learns, the next one pays for again."
            lead="Knowledge that costs real tokens, time and judgment to produce is kept per agent, per session, per store. Every agent starts from nothing, re-derives what others already worked out, and loses it when the session ends."
          />
        </div>
        <div class="problem-head__art k-reveal">
          <FragmentedKnowledge />
        </div>
      </div>
      <p class="problem-group k-mono">Across agents</p>
      <div class="problems">
        <div class="problem k-reveal">
          <h3>Every agent starts cold</h3>
          <p class="k-text-2">
            A research agent, a coding agent and an analyst working the same
            field each rebuild the same understanding, and each pays for it in
            full.
          </p>
        </div>
        <div class="problem k-reveal">
          <h3>Memory stays private</h3>
          <p class="k-text-2">
            What an assistant remembers lives in its own silo. Another agent,
            another machine or a colleague cannot inherit it, check it or correct
            it.
          </p>
        </div>
        <div class="problem k-reveal">
          <h3>Decisions go unrecorded</h3>
          <p class="k-text-2">
            Why an approach was chosen, and why another was dropped, ends with
            the session, so the dead end is explored again from scratch.
          </p>
        </div>
      </div>

      <p class="problem-group k-mono">In the stores</p>
      <div class="problems">
        <div class="problem k-reveal">
          <h3>Text, not comprehension</h3>
          <p class="k-text-2">
            RAG and its relatives embed whole documents as they are. They store
            the text, not the claims inside it, so there is nothing classified to
            reason over.
          </p>
        </div>
        <div class="problem k-reveal">
          <h3>Duplicated, not unified</h3>
          <p class="k-text-2">
            Two documents that say nearly the same thing are stored twice, as
            redundant chunks that drift apart, not as one fact with two
            references.
          </p>
        </div>
        <div class="problem k-reveal">
          <h3>No way to explain it</h3>
          <p class="k-text-2">
            There is no cross-reference, no corroboration, no confidence, and no
            way to see how a claim came to be believed.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Accumulate -->
  <section class="k-section phase">
    <div class="k-container">
      <SectionHeading
        eyebrow="1 · Accumulate"
        title="What any agent learns reaches every agent."
        lead="Each agent writes to its own branch; instances sync, host each other’s repositories and converge on one main. The corpus gathers one best statement of each claim rather than a pile of copies."
        align="center"
      />
      <FeatureGrid features={accumulate} />
      <p class="phase__more">
        <a href="/docs/sync-and-consensus/">Sync, consensus and conflicts <Icon name="arrow" size={16} /></a>
        <a href="/docs/fleet/">Fleets <Icon name="arrow" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- What is accumulated: facts, not documents -->
  <section class="k-section facts">
    <div class="k-container facts__grid">
      <div class="facts__copy">
        <SectionHeading
          eyebrow="What is accumulated"
          title="Anatomy of a fact."
          lead="knomit is not chunk-and-embed. Knowledge is captured as facts: atomic claims in plain markdown. Here is what one is made of."
        />
        <ul class="facts__list">
          {
            factTraits.map((t) => (
              <li>
                <Icon name={t.icon as any} size={18} /> {t.text}
              </li>
            ))
          }
        </ul>
      </div>
      <div class="facts__art k-reveal">
        <FactCard />
      </div>
    </div>
  </section>

  <!-- Distill -->
  <section class="k-section phase">
    <div class="k-container">
      <SectionHeading
        eyebrow="2 · Distill"
        title="Accumulation alone is a bigger pile."
        lead="The factory keeps reviewing what it has gathered: it merges what is redundant, derives conclusions no single source states, and surfaces where facts about unrelated subjects follow the same pattern."
        align="center"
      />
      <FeatureGrid features={distill} />
      <p class="phase__more">
        <a href="/docs/synthesis/">Synthesis <Icon name="arrow" size={16} /></a>
        <a href="/docs/discovery/">Discovery <Icon name="arrow" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- Use -->
  <section class="k-section phase">
    <div class="k-container">
      <SectionHeading
        eyebrow="3 · Use"
        title="Distilled knowledge goes back to work."
        lead="It flows into agents’ working context and into the decisions of the people beside them, and it can start work on its own. Every fact keeps its provenance, its confidence and the history of how it came to be believed."
        align="center"
      />
      <FeatureGrid features={use} />
      <p class="phase__more">
        <a href="/docs/mcp-tools/">MCP tools <Icon name="arrow" size={16} /></a>
        <a href="/docs/triggers/">Triggers and recipes <Icon name="arrow" size={16} /></a>
        <a href="/docs/experiments/">Experiments <Icon name="arrow" size={16} /></a>
        <a href="/use-cases/">Use cases <Icon name="arrow" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- Interop: publish as OKF -->
  <section class="k-section okfband-sec">
    <div class="k-container">
      <div class="okfband k-reveal">
        <div class="okfband__copy">
          <p class="k-eyebrow">Use it outside knomit too</p>
          <h2 class="okfband__title">Publish it as Open Knowledge Format.</h2>
          <p class="k-text-2 okfband__body">
            A knomit knowledge base is private and agent-shaped.
            <strong>knomit-okf</strong> publishes it as a portable
            <a href="/okf/">OKF</a> repository — Google Cloud's open spec — from a
            single git URL. Plain markdown any conformant consumer can read, and
            a bundle that is validated against the spec before it commits.
          </p>
          <a href="/okf/" class="k-btn k-btn--ghost okfband__cta">
            How publishing works <Icon name="arrow" size={16} />
          </a>
        </div>
        <div class="okfband__code">
          <pre class="k-mono"><span class="okfband__c">$</span> knomit-okf clone -b main &lt;kb-url&gt; my-kb
<span class="okfband__c">$</span> git push -u origin main

<span class="okfband__c">$</span> knomit-okf sync &amp;&amp; git push</pre>
          <p class="okfband__note k-mono">it commits · you push</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mechanism: git operations mean what they say -->
  <section class="k-section mech">
    <div class="k-container mech__grid">
      <div class="mech__copy">
        <SectionHeading
          eyebrow="The mechanism"
          title="Knowledge + commit."
          lead="The substrate is git, and knomit uses each git operation for what it means. Because the meaning is kept, the git tooling you already have works on the corpus unchanged: a pull request against kb/ is a review of beliefs."
        />
        <p class="k-text-2 mech__note">
          Git is the only source of truth. Indexes, embeddings and search are
          caches that can be rebuilt from it.
        </p>
      </div>
      <table class="mech__table k-reveal">
        <caption class="k-mono">git → knomit</caption>
        <thead>
          <tr><th scope="col">Git</th><th scope="col">In knomit</th></tr>
        </thead>
        <tbody>
          {gitOps.map((g) => (
            <tr>
              <th scope="row" class="k-mono">{g.op}</th>
              <td>{g.means}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <!-- From the blog -->
  {
    posts.length > 0 && (
      <section class="k-section">
        <div class="k-container">
          <div class="blogstrip__head">
            <SectionHeading eyebrow="From the blog" title="Real-world use cases." />
            <a href="/blog/" class="k-blogstrip__all">All posts <Icon name="arrow" size={16} /></a>
          </div>
          <div class="blogstrip">
            {posts.map((post) => (
              <BlogCard
                href={postHref(post)}
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                tags={post.data.tags}
              />
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FAQ (inline, links to full /faq) -->
  <section class="k-section">
    <div class="k-container">
      <SectionHeading
        eyebrow="FAQ"
        title="Common questions."
        align="center"
      />
      <dl class="home-faq">
        {HOME_FAQ_ITEMS.map((item) => (
          <div class="home-faq__item k-reveal">
            <dt class="home-faq__q">{item.q}</dt>
            <dd class="home-faq__a k-text-2">{item.a}</dd>
          </div>
        ))}
      </dl>
      <p class="home-faq__more">
        <a href="/faq/" class="k-btn k-btn--ghost">All questions <Icon name="arrow" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- Footer CTA -->
  <section class="k-section">
    <div class="k-container">
      <div class="cta k-reveal">
        <h2 class="cta__title">One body of knowledge for every participant.</h2>
        <p class="k-lead cta__lead">
          Source-available, and it is git underneath: typed, signed facts that agents
          and people accumulate, distill and use together. Browse a real
          knowledge base first, or run your own.
        </p>
        <div class="cta__actions">
          {DEMO_LIVE && <a href="/explore/" class="k-btn">Explore a live knowledge base</a>}
          <a href="/download/" class={DEMO_LIVE ? 'k-btn k-btn--ghost' : 'k-btn'}>Download knomit</a>
          <a href={GITHUB_URL} class="k-btn k-btn--ghost" rel="noopener">View on GitHub</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding-block: clamp(3rem, 1.5rem + 7vw, 7rem);
    border-bottom: 1px solid var(--k-hairline-soft);
    position: relative;
    overflow: hidden;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
  }
  .hero__title {
    font-size: var(--k-step-hero);
    margin: 0.5rem 0 0;
  }
  .hero__lead {
    margin-top: 1.5rem;
    max-width: 38rem;
  }
  .hero__lead strong {
    color: var(--k-brand);
    font-weight: 600;
  }
  .hero__cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 2rem;
  }
  .hero__sub {
    margin-top: 1.25rem;
    font-size: 0.82rem;
  }
  .hero__art {
    max-width: 560px;
    margin-inline: auto;
    width: 100%;
  }

  /* Facts section */
  .facts {
    background: var(--k-surface-1);
    border-bottom: 1px solid var(--k-hairline-soft);
  }
  .facts__grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 1rem + 4vw, 4rem);
    align-items: center;
  }
  .facts__list {
    list-style: none;
    margin: 0.25rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .facts__list li {
    display: flex;
    align-items: flex-start;
    gap: 0.7rem;
    color: var(--k-text);
    font-size: 0.98rem;
    line-height: 1.4;
  }
  .facts__list :global(.k-icon) {
    color: var(--k-brand);
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .facts__art {
    max-width: 440px;
    /* The fact card's own min-content was flooring the single-column track at
       363px inside a 338px container, so the page overflowed by ~4px on a
       phone. Grid items don't shrink past their content unless told to. */
    min-width: 0;
  }
  .facts__copy {
    min-width: 0;
  }

  /* Problem */
  .problem-head {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(1.5rem, 0.5rem + 4vw, 3.5rem);
    align-items: center;
    margin-bottom: 1.5rem;
  }
  .problem-head__art {
    max-width: 400px;
    margin-inline: auto;
  }
  .problems {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1.5rem;
  }
  .problem-group {
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--k-text-muted);
    margin: 2.25rem 0 1.1rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .problem-group::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--k-hairline-soft);
  }
  .problem-group:first-of-type {
    margin-top: 0.5rem;
  }
  .problem {
    border-left: 2px solid var(--k-retracted);
    padding-left: 1.1rem;
  }
  .problem h3 {
    font-size: 1.12rem;
    margin-bottom: 0.5rem;
  }
  .problem p {
    font-size: 0.94rem;
    line-height: 1.55;
  }

  /* OKF band */
  .okfband {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 0.75rem + 3vw, 3rem);
    align-items: center;
    padding: clamp(1.75rem, 1rem + 3vw, 2.75rem);
    border: 1px solid var(--k-hairline);
    border-radius: var(--k-radius-lg);
    background:
      radial-gradient(120% 150% at 100% 0%, var(--k-brand-glow), transparent 55%),
      var(--k-surface-1);
  }
  /* Long unbroken command lines would otherwise set the column's min-content
     width and push the band past its container. */
  .okfband > * {
    min-width: 0;
  }
  .okfband__title {
    font-size: var(--k-step-h3);
    margin: 0.4rem 0 0.75rem;
  }
  .okfband__body {
    line-height: 1.6;
    font-size: 0.96rem;
    max-width: 40rem;
  }
  .okfband__body strong {
    color: var(--k-brand);
    font-family: var(--k-font-mono);
    font-size: 0.94em;
    font-weight: 600;
  }
  .okfband__cta {
    margin-top: 1.4rem;
  }
  .okfband__code pre {
    margin: 0;
    padding: 1rem 1.1rem;
    background: var(--k-bg);
    border: 1px solid var(--k-hairline);
    border-radius: var(--k-radius);
    font-size: 0.78rem;
    line-height: 1.9;
    color: var(--k-text-2);
    overflow-x: auto;
  }
  .okfband__c {
    color: var(--k-brand);
  }
  .okfband__note {
    margin-top: 0.7rem;
    text-align: right;
    font-size: 0.72rem;
    color: var(--k-text-muted);
    letter-spacing: 0.05em;
  }

  /* Blog strip */
  .blogstrip__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }
  .blogstrip__head :global(.k-heading) {
    margin-bottom: 1.5rem;
  }
  .k-blogstrip__all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.92rem;
    white-space: nowrap;
    margin-bottom: 1.75rem;
  }
  .blogstrip {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
  }

  /* Inline FAQ */
  .home-faq { max-width: 52rem; margin: 2rem auto 0; display: grid; gap: 1.5rem; }
  .home-faq__item { border-left: 2px solid var(--k-hairline); padding-left: 1.1rem; }
