---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import { GITHUB_URL, DEMO_LIVE } from '../lib/site';

// The field doesn't divide cleanly by product — it divides by *operational
// profile*. Naming tools dates fast and reads as combative; clustering by how a
// tool actually behaves is durable, honest, and — fittingly — exactly what
// knomit does to knowledge. (Internal decoder: local/comp/README.md.)
const clusters = [
  {
    icon: 'search',
    name: 'Raw piles & DIY',
    profile:
      'You wire up a vector store or a folder of notes yourself. Text goes in; similar text comes back.',
    strong:
      'Dead simple, no new dependency — fine for one-shot retrieval over a static set of documents.',
    exposed:
      'Nothing dedups or structures itself. Duplicates pile up, knowledge drifts, and every chunk is trusted equally with no idea where it came from.',
  },
  {
    icon: 'api',
    name: 'Recall layers',
    profile:
      'Drop in a memory API. It captures the conversation automatically and replays the relevant bits next time.',
    strong:
      'Low-effort continuity for a single assistant, with broad framework integrations.',
    exposed:
      'Memories are flat free text with no link back to their source, siloed per agent, and impossible to review or version like code.',
  },
  {
    icon: 'ontology',
    name: 'Graph engines',
    profile:
      'Run a graph database, ingest data into entities and relationships, and reason across multiple hops.',
    strong:
      'Structured, multi-hop reasoning — and, at best, genuine temporal awareness of when a fact held.',
    exposed:
      'Heavy infrastructure bound to a database you can’t diff in a pull request, with unsigned facts and updates that sometimes overwrite history.',
  },
  {
    icon: 'mcp',
    name: 'Agent runtimes',
    profile:
      'Adopt a whole stateful-agent platform; the agent edits its own memory as it runs.',
    strong:
      'Self-editing memory and stateful agents out of the box, with strong tooling around the runtime.',
    exposed:
      'You inherit the entire runtime, each agent keeps its own private silo, and the change history — where it exists — is unsigned.',
  },
];

// Plotted on two axes: X = stores text → refines knowledge, Y = siloed/opaque →
// shared/auditable. knomit sits alone in the top-right.
const mapNodes = [
  { label: 'Raw piles', x: 13, y: 13 },
  { label: 'Recall layers', x: 33, y: 25 },
  { label: 'Agent runtimes', x: 48, y: 43 },
  { label: 'Graph engines', x: 60, y: 55 },
  { label: 'knomit', x: 82, y: 85, knomit: true },
];

const refinery = [
  {
    icon: 'cluster',
    title: 'It distills, not just stores',
    body: 'Similar inputs subsume into one fact; synthesis derives higher-order structure. Every other profile retrieves what is similar — knomit also discovers, surfacing emergent keystones across the cross-cluster bridges similarity is blind to. The corpus sharpens as it grows instead of bloating.',
  },
  {
    icon: 'discovery',
    title: 'It forms hypotheses',
    body: 'Synthesis extends into falsifiable predictions with settlement criteria. When evidence arrives, a hypothesis becomes an observation. That is a research capability — reasoning forward — not a recall one.',
  },
  {
    icon: 'provenance',
    title: 'Every change is signed — and reversible',
    body: 'Each write is a signed git commit by an agent whose identity is kept for life. A repository can verify those signatures when commits are accepted into main, against the fleet’s member records. Because the substrate is git, knomit prunes and rewrites itself safely: every refinement is a commit you can review, diff, and revert.',
    link: { href: '/security/', label: 'How the signing holds up' },
  },
  {
    icon: 'consensus',
    title: 'Knowledge converges across agents and machines',
    body: 'Agents and people write on their own branches; facts reach main by review or by automatic merge, and edits to the same fact can be merged field by field. Instances sync in real time and host each other’s repositories, so what one agent learns, every agent inherits.',
  },
  {
    icon: 'markdown',
    title: 'It exports to a standard nobody owns',
    body: 'Every profile above is somewhere knowledge goes in and does not come out. knomit publishes the whole base as Open Knowledge Format — Google Cloud’s open spec — plain markdown in a git repo that any conformant consumer can read without knomit in the picture. The exit is the feature.',
    link: { href: '/okf/', label: 'How OKF export works' },
  },
];

// Coordination: what lets many agents on many machines work as one fabric.
// The profile column describes the four profiles above as documented, not any
// one product; it was not re-checked against rival docs for this revision.
const coordination = [
  {
    cap: 'Experiments',
    knomit: 'An agent stages work on a local branch forked from its own; commit merges it as a unit, rollback discards it. Never pushed.',
  },
  {
    cap: 'Triggers and recipes',
    knomit: 'Rules in the ontology fire when facts are learned, updated, retracted or fall due, and can run a script or a recipe that starts an agent session.',
  },
  {
    cap: 'Signed identity, verified at acceptance',
    knomit: 'Each agent has a kept identity and signs every commit; a repository can refuse commits into main not signed by an active fleet member’s current key.',
  },
  {
    cap: 'Conflict merge',
    knomit: 'When two agents changed the same fact, the merge can combine their edits field by field or let consensus win, and records every conflict it settled.',
  },
  {
    cap: 'Lenses across machines',
    knomit: 'One query reads several knowledge bases at once, including ones synced from other machines, with one shared motif vocabulary.',
  },
];

const reach = [
  'Knowledge has to be shared and trusted across many agents and humans, not siloed inside one tool.',
  'Several agents or machines work on the same problem and should build on each other’s results.',
  'You need to explain a claim — where it came from, how confident it is, how it changed.',
  'You want it reviewable like code and hostable anywhere: it’s just a git repo.',
  'You want the store to improve itself — dedup, synthesis, hypotheses — not merely hold text.',
];

const outgrow = [
  'You only need conversational recall for a single assistant, and that’s the whole job.',
  'A one-shot retrieval over a static document set already answers your questions.',
  'There’s nothing to dedup, explain, version, or share — raw similarity search is enough.',
];

const mapAria =
  'Positioning map. Horizontal axis runs from storing text to refining knowledge; vertical axis from siloed and opaque to shared and auditable. Raw piles and DIY sit in the lower-left, recall layers lower-center, agent runtimes in the middle, graph engines mid-right, and knomit alone in the upper-right — the only profile that both refines and audits.';
---

<BaseLayout
  title="knomit vs RAG, recall layers, graph engines and agent runtimes — comparison"
  description="How knomit compares to RAG, recall layers, graph engines and agent runtimes: a fabric that accumulates, distills and shares knowledge across many agents."
>
  <!-- Reframe + map -->
  <section class="k-section">
    <div class="k-container">
      <SectionHeading
        as="h1"
        eyebrow="Comparison"
        title="The landscape, by operational profile."
        lead="The tools agents use for memory cluster into four profiles. Each is good at something. None of them is built to connect many agents and many knowledge bases so that what one learns is distilled and used by all, with every change auditable. That is what knomit is for."
      />

      <div
        class="cmp-map k-reveal"
        role="img"
        aria-label={mapAria}
      >
        <span class="cmp-map__frontier" aria-hidden="true"></span>
        <span class="cmp-map__axis cmp-map__axis--x" aria-hidden="true">
          stores text&nbsp; →&nbsp; refines knowledge
        </span>
        <span class="cmp-map__axis cmp-map__axis--y" aria-hidden="true">
          siloed / opaque&nbsp; →&nbsp; shared / auditable
        </span>
        {mapNodes.map((n) => (
          <span
            class={`cmp-node${n.knomit ? ' cmp-node--knomit' : ''}`}
            style={`left:${n.x}%; bottom:${n.y}%`}
          >
            {n.label}
          </span>
        ))}
      </div>
      <p class="cmp-note k-text-2">
        The four profiles store and retrieve. knomit also distills what it holds,
        shares it across agents, and signs every change.
      </p>
    </div>
  </section>

  <!-- The four clusters -->
  <section class="k-section cmp-clusters">
    <div class="k-container">
      <SectionHeading
        eyebrow="The four profiles"
        title="What each cluster is good at — and where it leaves you exposed."
        lead="Operational profiles describe what a system can do and how it behaves at runtime — capabilities, not brand names — so they stay stable even as tools churn. You’ll recognise where your stack sits."
        align="center"
      />
      <div class="cmp-grid">
        {clusters.map((c) => (
          <div class="cmp-card k-reveal">
            <span class="cmp-card__icon" aria-hidden="true">
              <Icon name={c.icon as any} size={20} />
            </span>
            <h3 class="cmp-card__title">{c.name}</h3>
            <p class="cmp-card__profile k-text-2">{c.profile}</p>
            <div class="cmp-card__row">
              <span class="cmp-card__k cmp-card__k--yes">Strong</span>
              <p>{c.strong}</p>
            </div>
            <div class="cmp-card__row">
              <span class="cmp-card__k cmp-card__k--no">Exposed</span>
              <p>{c.exposed}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- knomit: the refinery -->
  <section class="k-section cmp-refinery">
    <div class="k-container">
      <SectionHeading
        eyebrow="Where knomit sits"
        title="A fifth profile: the knowledge distillation factory."
        lead="knomit is not a better point on the memory axis. It is a fabric of many agents and many knowledge bases that accumulates knowledge, distills it, and puts it to use, signing every change so you can trust what it kept and what it dropped."
        align="center"
      />
      <div class="cmp-grid">
        {refinery.map((r) => (
          <div class="cmp-card cmp-card--brand k-reveal">
            <span class="cmp-card__icon" aria-hidden="true">
              <Icon name={r.icon as any} size={20} />
            </span>
            <h3 class="cmp-card__title">{r.title}</h3>
            <p class="cmp-card__profile k-text-2">{r.body}</p>
            {r.link && (
              <a href={r.link.href} class="cmp-card__link">
                {r.link.label} <Icon name="arrow" size={15} />
              </a>
            )}
          </div>
        ))}
      </div>

      <p class="cmp-callout k-reveal">
        Provenance, time-travel, and synthesis aren’t three features. They’re
        one: <strong>a knowledge base that improves itself — and lets you audit
        every improvement.</strong>
      </p>

      <p class="cmp-underneath k-text-2">
        Underneath it all: typed atomic facts, not chunks; a customisable
        epistemic ontology you author in plain markdown; confidence that rises
        and falls with the evidence; and external references that keep
        provenance intact beyond the corpus.
      </p>
    </div>
  </section>

  <!-- Coordination -->
  <section class="k-section cmp-coord">
    <div class="k-container">
      <SectionHeading
        eyebrow="Coordination"
        title="What it takes for many agents to work as one."
        lead="Sharing a store is not the same as working together. These are the pieces knomit has for agents on several machines building one body of knowledge."
        align="center"
      />
      <!-- UNVERIFIED: the "four profiles" column (No equivalent documented) was not re-checked against each rival's public docs in the 2026-10 refresh. -->
      <div class="cmp-table-wrap k-reveal">
        <table class="cmp-table">
          <caption class="k-text-2">
            The profiles column is as documented, as of October 2026.
          </caption>
          <thead>
            <tr>
              <th scope="col">Capability</th>
              <th scope="col">knomit</th>
              <th scope="col">The four profiles</th>
            </tr>
          </thead>
          <tbody>
            {coordination.map((row) => (
              <tr>
                <th scope="row">{row.cap}</th>
                <td>{row.knomit}</td>
                <td class="cmp-table__none">No equivalent documented</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="cmp-coord__more k-text-2">
        Read more: <a href="/docs/experiments/">experiments</a>,
        <a href="/docs/triggers/">triggers and recipes</a>,
        <a href="/docs/fleet/">fleets</a>,
        <a href="/docs/sync-and-consensus/">sync and consensus</a>,
        <a href="/docs/lenses/">lenses</a>.
      </p>
    </div>
  </section>

  <!-- Honest fit -->
  <section class="k-section">
    <div class="k-container">
      <SectionHeading
        eyebrow="Is it the right tool?"
        title="When to reach for knomit — and when not to."
        lead="We’d rather you pick the right cluster than the loudest one."
        align="center"
      />
      <div class="cmp-fit">
        <div class="cmp-fit__col cmp-fit__col--yes k-reveal">
          <h3 class="cmp-fit__head">
            <Icon name="provenance" size={17} /> Reach for knomit when…
          </h3>
          <ul class="cmp-fit__list">
            {reach.map((f) => <li>{f}</li>)}
          </ul>
        </div>
        <div class="cmp-fit__col cmp-fit__col--no k-reveal">
          <h3 class="cmp-fit__head">A simpler cluster is fine when…</h3>
          <ul class="cmp-fit__list">
            {outgrow.map((f) => <li>{f}</li>)}
          </ul>
        </div>
      </div>
      <p class="cmp-fit__more k-text-2">
        Recognise yourself on the left?
        <a href="/use-cases/">See what people build on it</a>, from a research
        corpus to work coordinated across several machines.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="k-section">
    <div class="k-container cmp-cta">
      <h2>See knowledge compound, not drift.</h2>
      <p class="k-lead cmp-cta__lead">
        It’s open source and it’s just git. Clone it, point your agents at it,
        and watch the corpus sharpen itself.
      </p>
      <div class="cmp-cta__actions">
        <a href={GITHUB_URL} class="k-btn" rel="noopener">View on GitHub</a>
        <a href="/docs/quick-start/" class="k-btn k-btn--ghost">
          Quick start <Icon name="arrow" size={16} />
        </a>
        {DEMO_LIVE && (
          <a href="/explore/" class="k-btn k-btn--ghost">Explore</a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── Positioning map ─────────────────────────────────────────────── */
  .cmp-map {
    position: relative;
    margin-top: 2.5rem;
    height: clamp(300px, 38vh, 400px);
    border: 1px solid var(--k-hairline);
    border-radius: var(--k-radius-lg);
    background:
      radial-gradient(115% 115% at 100% 0%, var(--k-brand-glow), transparent 46%),
      linear-gradient(0deg, var(--k-surface-1), var(--k-surface-1));
    overflow: hidden;
  }
  /* faint frontier the others never reach */
  .cmp-map__frontier {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--k-hairline-soft) 1px, transparent 1px),
      linear-gradient(to top, var(--k-hairline-soft) 1px, transparent 1px);
    background-size: 25% 25%;
    opacity: 0.5;
    pointer-events: none;
  }
  .cmp-map__axis {
    position: absolute;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--k-text-muted);
    white-space: nowrap;
  }
  .cmp-map__axis--x {
    left: 50%;
    bottom: 0.7rem;
    transform: translateX(-50%);
  }
  .cmp-map__axis--y {
    left: 0.7rem;
    top: 50%;
    transform: translateY(-50%) rotate(180deg);
    writing-mode: vertical-rl;
  }
  .cmp-node {
    position: absolute;
    transform: translate(-50%, 50%);
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    color: var(--k-text-2);
    white-space: nowrap;
  }
  .cmp-node::before {
    content: '';
    flex: none;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--k-text-muted);
  }
  .cmp-node--knomit {
    color: var(--k-brand);
    font-weight: 600;
    font-size: 0.98rem;
  }
  .cmp-node--knomit::before {
    width: 13px;
    height: 13px;
    background: var(--k-brand);
    box-shadow: 0 0 0 5px var(--k-brand-glow);
  }
  .cmp-note {
    margin-top: 1.25rem;
    text-align: center;
    font-size: 0.95rem;
  }

  /* ── Cluster cards ───────────────────────────────────────────────── */
  .cmp-clusters {
    background: var(--k-surface-1);
    border-block: 1px solid var(--k-hairline-soft);
  }
  .cmp-grid {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.25rem;
  }
  .cmp-card {
    border: 1px solid var(--k-hairline);
    border-radius: var(--k-radius);
    padding: 1.4rem;
    background: var(--k-bg);
  }
  .cmp-card__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.7rem;
    font-size: 0.92rem;
    font-weight: 500;
  }
  .cmp-card--brand {
    border-color: rgba(119, 204, 153, 0.3);
    background:
      radial-gradient(130% 120% at 0% 0%, var(--k-brand-glow), transparent 60%),
      var(--k-bg);
  }
  .cmp-card__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    color: var(--k-brand);
    background: var(--k-brand-glow);
    border: 1px solid rgba(119, 204, 153, 0.25);
    margin-bottom: 0.9rem;
  }
  .cmp-card__title {
    font-size: 1.05rem;
    margin-bottom: 0.5rem;
  }
  .cmp-card__profile {
    line-height: 1.6;
    font-size: 0.94rem;
  }
  .cmp-card__row {
    display: flex;
    gap: 0.7rem;
    margin-top: 1rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .cmp-card__row p {
    color: var(--k-text-2);
  }
  .cmp-card__k {
    flex: none;
    width: 4.4rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    padding-top: 0.1rem;
  }
  .cmp-card__k--yes {
    color: var(--k-brand);
  }
  .cmp-card__k--no {
    color: var(--k-text-muted);
  }

  /* ── Refinery ────────────────────────────────────────────────────── */
  .cmp-callout {
    margin: 2.5rem auto 0;
    max-width: 44rem;
    text-align: center;
    font-size: var(--k-step-lead);
    line-height: 1.5;
    color: var(--k-text-2);
  }
  .cmp-callout strong {
    color: var(--k-text);
  }
  .cmp-underneath {
    margin: 1.5rem auto 0;
    max-width: 44rem;
    text-align: center;
    font-size: 0.94rem;
    line-height: 1.65;
  }

  /* ── Coordination ────────────────────────────────────────────────── */
  .cmp-coord {
    background: var(--k-surface-1);
    border-block: 1px solid var(--k-hairline-soft);
  }
  .cmp-table-wrap {
    margin-top: 2.5rem;
    overflow-x: auto;
  }
  .cmp-table {
    width: 100%;
    min-width: 36rem;
    border-collapse: collapse;
    border: 1px solid var(--k-hairline);
    background: var(--k-bg);
    font-size: 0.93rem;
    line-height: 1.5;
  }
  .cmp-table caption {
    caption-side: bottom;
    text-align: left;
    padding-top: 0.7rem;
    font-size: 0.85rem;
  }
  .cmp-table th,
  .cmp-table td {
    text-align: left;
    vertical-align: top;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--k-hairline-soft);
  }
  .cmp-table thead th {
    font-size: 0.75rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--k-text-muted);
  }
  .cmp-table tbody th {
    color: var(--k-brand);
    font-weight: 600;
    width: 22%;
  }
  .cmp-table td {
    color: var(--k-text-2);
  }
  .cmp-table__none {
    color: var(--k-text-muted);
    width: 22%;
  }
  .cmp-coord__more {
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.95rem;
  }
  .cmp-coord__more a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  /* ── Honest fit ──────────────────────────────────────────────────── */
  .cmp-fit {
    margin-top: 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .cmp-fit__col {
    border: 1px solid var(--k-hairline);
    border-radius: var(--k-radius);
    padding: 1.5rem 1.6rem;
    background: var(--k-surface-1);
  }
  .cmp-fit__col--yes {
    border-color: rgba(119, 204, 153, 0.4);
    background:
      radial-gradient(120% 140% at 0% 0%, var(--k-brand-glow), transparent 55%),
      var(--k-surface-1);
  }
  .cmp-fit__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.05rem;
    margin-bottom: 1rem;
  }
  .cmp-fit__col--yes .cmp-fit__head :global(.k-icon) {
    color: var(--k-brand);
  }
  .cmp-fit__more {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  /* This link sits inside a paragraph, so colour alone cannot mark it: the
     link and its surrounding text are under 3:1 against each other, which
     leaves nothing for a colour-blind reader to go on. Underline it. */
  .cmp-fit__more a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .cmp-fit__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
  }
  .cmp-fit__list li {
    position: relative;
    padding-left: 1.1rem;
    line-height: 1.5;
    font-size: 0.94rem;
    color: var(--k-text-2);
  }
  .cmp-fit__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--k-text-muted);
  }
  .cmp-fit__col--yes .cmp-fit__list li::before {
    background: var(--k-brand);
  }

  /* ── CTA ─────────────────────────────────────────────────────────── */
  .cmp-cta {
    text-align: center;
  }
  .cmp-cta h2 {
    font-size: var(--k-step-h2);
    margin-bottom: 1rem;
  }
  .cmp-cta__lead {
    margin: 0 auto 2rem;
    max-width: 40rem;
  }
  .cmp-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    justify-content: center;
  }

  @media (max-width: 640px) {
    .cmp-map {
      height: 360px;
    }
    .cmp-node {
      font-size: 0.72rem;
    }
    .cmp-fit {
      grid-template-columns: 1fr;
    }
  }
</style>
